pkgname=chalk
pkgver=0.3.0
pkgrel=1
pkgdesc='A simple whiteboard for diagrams and rough layouts'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/chalk "$pkgdir/usr/bin/chalk"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/chalk.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/chalk.svg"
  install -Dm644 "$startdir/chalk.desktop" "$pkgdir/usr/share/applications/chalk.desktop"
  # Teaches the desktop that .chalk files are boards, so they open here.
  install -Dm644 "$startdir/chalk.xml" "$pkgdir/usr/share/mime/packages/chalk.xml"
}
